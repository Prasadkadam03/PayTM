DBURL=mongodb://localhost:27017/PayTm?replicaSet=rs0
PORT=3000
# at least 32 random characters, required in production
JWT_SECRET=your_jwt_secret
NODE_ENV=development

# frontend urls allowed to call the api, comma separated
CORS_ORIGIN=http://localhost:5173

# access token lifetime and refresh cookie lifetime
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# email via resend.com. without a key emails are printed to the console
RESEND_API_KEY=
MAIL_FROM=PayTM <onboarding@resend.dev>
# frontend url used in email links
APP_URL=http://localhost:5173
